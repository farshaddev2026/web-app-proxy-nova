{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app-proxy-nova",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "48b9846c-e3b5-4f56-99ec-23eaeb67d0c5","database_name": "web-app-sivan" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "b13c39517bcc4549b04169ab57ca11aa" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
